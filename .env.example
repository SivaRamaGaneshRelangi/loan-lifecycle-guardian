# Copy to .env for local configuration. Never commit .env or real credentials.
# Replace this placeholder with a unique random value outside local demos.
JWT_SECRET=replace-this-placeholder-with-a-long-random-secret
JWT_EXPIRE_MIN=120

# Optional: set GEMINI_API_KEY or GOOGLE_API_KEY in this file or in your shell.
# Without a key, the deterministic rules-based assistant remains available.
GEMINI_MODEL=gemini-3.8-flash

# Demo data and simulated sandbox controls. Disable for a non-demo deployment.
DEMO_MODE=1
SEED_DEMO=1

# 0 = off. Example: 3600 runs the simulated auto-debit engine hourly.
AUTOPAY_SCHEDULER_SECONDS=0
MAX_AUTOPAY_ATTEMPTS=5
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Database is SQLite by default; uncomment and configure exactly one alternative.
# SQL Server requires pyodbc plus a compatible Microsoft ODBC Driver.
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/LoanGuardian?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# PostgreSQL requires psycopg2-binary.
# DATABASE_URL=postgresql+psycopg2://user:password@host/database?sslmode=require
